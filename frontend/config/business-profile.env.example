# Copy the KEYS to the frontend environment only after the owner approves public use.
# Values are intentionally empty. This file does not configure verified business facts.
# Pages are prerendered: changes require a new validated build and deployment.
INGARAGE_PUBLIC_BUSINESS_CONFIRMED=false
INGARAGE_PUBLIC_LEGAL_NAME=
INGARAGE_PUBLIC_TAX_ID_TYPE=
INGARAGE_PUBLIC_TAX_ID=
INGARAGE_PUBLIC_BUSINESS_ADDRESS=
INGARAGE_PUBLIC_SUPPORT_EMAIL=
INGARAGE_PUBLIC_PRIVACY_EMAIL=
# Optional; if used, E.164 Brazilian form (+55 plus DDD and subscriber digits).
INGARAGE_PUBLIC_SUPPORT_PHONE=
INGARAGE_PUBLIC_SUPPORT_HOURS=
# Plain text only, one line per value; no HTML. No invented deadlines.
INGARAGE_PUBLIC_POLICIES_CONFIRMED=false
INGARAGE_PUBLIC_POLICY_UPDATED_AT=
INGARAGE_PUBLIC_DELIVERY_TERMS=
INGARAGE_PUBLIC_RETURN_INSTRUCTIONS=
INGARAGE_PUBLIC_REFUND_TERMS=
INGARAGE_PUBLIC_PRIVACY_RETENTION=
INGARAGE_PUBLIC_PRIVACY_TRANSFERS=
